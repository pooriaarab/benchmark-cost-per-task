{
  "name": "benchmark-cost-per-task",
  "version": "0.2.0",
  "description": "AI agent benchmark for cost per verified back-office task with deterministic grading, OpenRouter pricing, CLI, SDK, API, and MCP.",
  "keywords": ["ai-benchmark", "agent-benchmark", "agent-evaluation", "llm-evaluation", "model-evaluation", "cost-per-task", "llm-cost", "evals", "grading", "openrouter", "openai", "mcp", "typescript"],
  "homepage": "https://private-repo-337e.com/benchmarks/benchmark-cost-per-task",
  "bugs": "https://github.com/pooriaarab/benchmark-cost-per-task/issues",
  "repository": { "type": "git", "url": "git+https://github.com/pooriaarab/benchmark-cost-per-task.git" },
  "license": "MIT", "author": "Pooria Arab", "type": "module",
  "main": "./dist/index.js", "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./mcp": { "types": "./dist/mcp.d.ts", "import": "./dist/mcp.js" },
    "./api": { "types": "./dist/api.d.ts", "import": "./dist/api.js" }
  },
  "bin": { "benchmark-cost-per-task": "./dist/cli.js" },
  "files": ["dist", "data", "docs", "scripts", "README.md", "AGENTS.md", "llms.txt", "server.json", "LICENSE"],
  "engines": { "node": ">=20" }, "sideEffects": false,
  "scripts": {
    "lint": "oxlint src scripts", "typecheck": "tsc --noEmit", "build": "tsup",
    "provenance": "node scripts/provenance.mjs", "generate:tasks": "node scripts/gen-tasks.mjs",
    "fetch:prices": "node scripts/fetch-prices.mjs",
    "e2e": "node scripts/e2e.mjs", "ci:local": "npm run lint && npm run typecheck && npm run build && npm run e2e"
  },
  "dependencies": { "@modelcontextprotocol/sdk": "^1.20.1", "benchmark-core": "^0.1.0" },
  "devDependencies": { "@types/node": "^24.0.0", "oxlint": "^1.23.0", "tsup": "^8.5.0", "typescript": "^5.9.3" },
  "publishConfig": { "access": "public" }
}
